{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["node"]
	},
	"include": [
		"./**/*.ts",
		"../src/lib/contact-lock.ts",
		"../src/lib/visitor-notes-types.ts",
		"../src/data/portfolio.ts"
	]
}
