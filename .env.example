# Visitor notes — persistent live counts (pick one on Vercel)
# Option A: Vercel KV (recommended)
# Vercel Dashboard → Storage → Create Database → KV → Connect to this project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Option B: Vercel Blob (auto-created when you add Blob storage to the project)
# BLOB_READ_WRITE_TOKEN=
# Optional — defaults to private (use public only for legacy public blob stores)
# BLOB_ACCESS=private
